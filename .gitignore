# Byte-compiled / optimized / DLL files
__pycache__/
*.py[cod]
*$py.class

# Virtual environments
.venv/
.uv/

# Distribution / packaging
build/
dist/
*.egg-info/

# Unit test / coverage reports
.coverage
htmlcov/
.pytest_cache/

# IDE/editor
.vscode/
.idea/

# Inputs (keep sample files checked in; real puzzle inputs must not be published)
inputs/**
!inputs/**/
!inputs/**/*.sample.txt

# Local secrets, e.g. an Advent of Code session cookie
.env
.env.*
!.env.example

# Linters and formatters
.ruff_cache/